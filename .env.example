# Environment variable reference (template).
#
# Copy to `.env` (never committed) and fill in real values. Every
# operationally-meaningful variable the project reads MUST be documented
# here — see memory/policies/05-security-and-secrets.md.
#
# Use clearly-fake placeholders in this file (REDACTED, your-*, xxxx).

# ---- Application ----
APP_ENV=local
LOG_LEVEL=INFO
HTTP_PORT=8080

# ---- PostgreSQL (see memory/stacks/postgresql.md) ----
POSTGRES_URL=postgresql://localhost:5432/app
POSTGRES_USER=app
POSTGRES_PASSWORD=your-password-here

# ---- MongoDB (see memory/stacks/mongodb.md) ----
MONGODB_URI=mongodb://localhost:27017/app

# ---- Redis / Valkey (see memory/stacks/redis.md) ----
REDIS_URL=redis://localhost:6379/0

# ---- Kafka (see memory/stacks/messaging-kafka.md) ----
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_SASL_USERNAME=your-username-here
KAFKA_SASL_PASSWORD=your-password-here

# ---- External services ----
# EXAMPLE_API_BASE_URL=https://api.example.com
# EXAMPLE_API_KEY=sk-REDACTED
